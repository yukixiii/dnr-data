{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dnr.schema.json",
  "description": "src/types.ts と同期させること",
  "definitions": {
    "region": { "enum": ["JP", "KR", "CN"] },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source"],
        "properties": { "source": { "type": "string" }, "note": { "type": "string" } }
      }
    },
    "qty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "qty"],
      "properties": { "item": { "type": "string" }, "qty": { "type": ["number", "string"] } }
    },
    "stat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": { "name": { "type": "string" }, "value": { "type": "string" }, "note": { "type": "string" } }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "region", "kind", "title", "fetched_at"],
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string" },
        "region": { "$ref": "#/definitions/region" },
        "kind": { "enum": ["official", "wiki", "community"] },
        "title": { "type": "string" },
        "published_at": { "$ref": "#/definitions/date" },
        "fetched_at": { "$ref": "#/definitions/date" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "refs"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "name_ko": { "type": "string" },
        "name_zh": { "type": "string" },
        "kind": {
          "enum": ["weapon", "armor", "accessory", "special_armor", "artifact", "talisman", "jade", "heraldry", "material", "currency", "box", "consumable", "other"]
        },
        "slot": { "type": "string" },
        "grade": { "type": "string" },
        "level": { "type": "number" },
        "series": { "type": "string" },
        "max_enhance": { "type": "number" },
        "tradable": { "type": "string" },
        "set": { "type": "string" },
        "description": { "type": "string" },
        "stats": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "stats"],
            "properties": {
              "label": { "type": "string" },
              "stats": { "type": "array", "items": { "$ref": "#/definitions/stat" } }
            }
          }
        },
        "obtain": { "type": "array", "items": { "type": "string" } },
        "refs": { "$ref": "#/definitions/refs" }
      }
    },
    "item_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "bonuses", "refs"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "bonuses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["count"],
            "properties": {
              "count": { "type": "number" },
              "stats": { "type": "array", "items": { "$ref": "#/definitions/stat" } },
              "skill": { "type": "string" }
            }
          }
        },
        "notes": { "type": "string" },
        "refs": { "$ref": "#/definitions/refs" }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "result", "materials", "refs"],
      "properties": {
        "id": { "type": "string" },
        "type": { "enum": ["craft", "evolve", "refine", "exchange", "upgrade", "dismantle", "other"] },
        "result": { "type": "string" },
        "result_qty": { "type": "number" },
        "base": { "type": "string" },
        "materials": { "type": "array", "items": { "$ref": "#/definitions/qty" } },
        "gold": { "type": "number" },
        "where": { "type": "string" },
        "rate": { "type": "number" },
        "rate_text": { "type": "string" },
        "notes": { "type": "string" },
        "refs": { "$ref": "#/definitions/refs" }
      }
    },
    "enhance_table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "applies_to", "rows", "refs"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "enum": ["enhance", "craft_stage", "refine", "evolve", "other"] },
        "applies_to": { "type": "array", "items": { "type": "string" } },
        "applies_note": { "type": "string" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level"],
            "properties": {
              "level": { "type": "string" },
              "rate": { "type": "number", "minimum": 0, "maximum": 100 },
              "rate_text": { "type": "string" },
              "gold": { "type": ["number", "string"] },
              "materials": { "type": "array", "items": { "$ref": "#/definitions/qty" } },
              "on_fail": { "type": "string" },
              "stats": { "type": "array", "items": { "$ref": "#/definitions/stat" } }
            }
          }
        },
        "notes": { "type": "string" },
        "refs": { "$ref": "#/definitions/refs" }
      }
    },
    "drop_table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "location", "location_kind", "entries", "refs"],
      "properties": {
        "id": { "type": "string" },
        "location": { "type": "string" },
        "location_kind": { "enum": ["dungeon", "box", "shop", "quest", "gather", "other"] },
        "label": { "type": "string" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item"],
            "properties": {
              "item": { "type": "string" },
              "from": { "type": "string" },
              "floors": { "type": "string" },
              "rate": { "type": "number", "minimum": 0, "maximum": 100 },
              "rate_text": { "type": "string" },
              "qty": { "type": ["number", "string"] }
            }
          }
        },
        "notes": { "type": "string" },
        "refs": { "$ref": "#/definitions/refs" }
      }
    },
    "dungeon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "refs"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "enum": ["nest", "stage", "dungeon", "raid", "pvp", "event", "other"] },
        "entry": { "type": "string" },
        "level": { "type": "number" },
        "difficulty": { "type": "string" },
        "notes": { "type": "string" },
        "refs": { "$ref": "#/definitions/refs" }
      }
    },
    "item_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "members"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "members": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item", "label"],
            "properties": {
              "item": { "type": "string" },
              "label": { "type": "string" },
              "phase": { "type": "string" },
              "from": { "type": "string" },
              "via": { "type": "string" }
            }
          }
        },
        "notes": { "type": "string" },
        "refs": { "$ref": "#/definitions/refs" }
      }
    }
  }
}
